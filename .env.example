HELPDESK_URL=https://nakywgkztvzkihdjnwbc.supabase.co/functions/v1/helpdesk
HELPDESK_KEY=
CANDIDATE_EMAIL=
CANDIDATE_NAME=

# Any OpenAI-compatible endpoint. OpenRouter: https://openrouter.ai/api/v1 | Ollama: http://localhost:11434/v1
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_API_KEY=
LLM_MODEL=qwen/qwen-2.5-72b-instruct
# Model that checks draft replies. Empty = same as LLM_MODEL. A different model gives an independent check.
VERIFY_MODEL=
# OpenRouter only: pin one provider (no fallbacks) so runs are comparable. Empty = OpenRouter routes.
LLM_PROVIDER=deepinfra/fp8
# Fixed sampling seed. Default 42.
LLM_SEED=42

# Price per 1M tokens, used for the eval cost estimate. Defaults to 0 when unset.
LLM_PRICE_PER_MILLION_INPUT=0.36
LLM_PRICE_PER_MILLION_OUTPUT=0.40
# Hand off when the model's reply confidence is below this. Default 0.75.
REPLY_CONFIDENCE_MIN=0.75
